# .env.example — Dummy-Werte für alle Umgebungsvariablen
# Kopieren und befüllen: cp .env.example .env
# NIEMALS die echte .env ins Repo committen!

# === Allgemein ===
TIMEZONE=Europe/Berlin
DOMAIN=deine-domain.tld

# === Traefik (VPS) ===
ACME_EMAIL=deine@email.de
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=GEHEIMERPASSWORDHASH

# === Authelia (VPS) ===
AUTHELIA_JWT_SECRET=ZUFAELLIGER_LANGER_STRING_HIER
AUTHELIA_SESSION_SECRET=ANDERER_ZUFAELLIGER_STRING
AUTHELIA_STORAGE_ENCRYPTION_KEY=NOCH_EIN_GEHEIMER_SCHLUESSEL

# === n8n ===
N8N_HOST=n8n.deine-domain.tld
N8N_ENCRYPTION_KEY=ZUFAELLIGER_ENCRYPTION_KEY
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=SICHERES_DB_PASSWORT

# === Open WebUI ===
OPEN_WEBUI_SECRET_KEY=ZUFAELLIGER_WEBUI_SECRET

# === WireGuard ===
# Keys werden in der wg0.conf gesetzt — hier nur Netzwerkinfo
WG_VPS_IP=10.8.0.1
WG_VM_IP=10.8.0.2
WG_SUBNET=10.8.0.0/24

# === Backup ===
BACKUP_DIR=/opt/homelab-backups
