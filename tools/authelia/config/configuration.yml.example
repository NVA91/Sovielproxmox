# Authelia Konfiguration — VORLAGE
# Echte config: tools/authelia/config/configuration.yml (nicht im Repo!)
# Doku: https://www.authelia.com/configuration/

theme: dark
default_redirection_url: https://DEINE_DOMAIN.tld

server:
  host: 0.0.0.0
  port: 9091

log:
  level: info

totp:
  issuer: DEINE_DOMAIN.tld

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: deny
  rules:
    - domain: "*.DEINE_DOMAIN.tld"
      policy: two_factor

session:
  name: authelia_session
  secret: DEIN_SESSION_SECRET_HIER
  expiration: 3600
  inactivity: 300
  domain: DEINE_DOMAIN.tld
  redis:
    host: authelia-redis
    port: 6379

storage:
  local:
    path: /data/db.sqlite3

notifier:
  filesystem:
    filename: /data/notification.txt
  # smtp:
  #   username: SMTP_USER
  #   password: SMTP_PASSWORD
  #   host: smtp.example.com
  #   port: 587
  #   sender: authelia@DEINE_DOMAIN.tld
